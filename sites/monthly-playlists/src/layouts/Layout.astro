---
import "../styles/site.css";

interface Props {
    title?: string;
}

const { title = "Monthly Playlists" } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="theme-color" content="#222222" />
        <title>{title}</title>
    </head>

    <body>
        <main class="main container" id="content">
            <slot />
        </main>
        <footer class="footer container" id="footer">
            <p>&copy; {year} Badr Choubai</p>
            <ul>
                <li>
                    <a href="https://friends-sharing-system.badrchoubai.dev"
                        >Subscribe to these playlists</a
                    >
                </li>
                <li><a href="https://badrchoubai.dev">badrchoubai.dev</a></li>
            </ul>
        </footer>
    </body>
</html>
