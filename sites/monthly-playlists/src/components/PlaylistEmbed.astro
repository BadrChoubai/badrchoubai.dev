---
interface Props {
    month: string;
    id: string;
}

const { month, id } = Astro.props;
---

<article class="playlist">
    <h3>{month}</h3>
    <iframe
        title={`${month} playlist on Spotify`}
        src={`https://open.spotify.com/embed/playlist/${id}?utm_source=generator`}
        width="100%"
        height="152"
        frameborder="0"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"></iframe>
</article>
