---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  book: CollectionEntry<"books">["data"];
  width?: number;
}

const { book, width = 320 } = Astro.props;
---

<div class="cover" style={`--cover-color: ${book.color};`}>
  {
    book.cover ? (
      <Image src={book.cover} alt={`Cover of ${book.title}`} width={width} />
    ) : (
      <div class="cover__plain" aria-hidden="true">
        <span class="cover__title">{book.title}</span>
        <span class="cover__author">{book.author}</span>
      </div>
    )
  }
</div>

<style>
  .cover {
    aspect-ratio: 2 / 3;
    width: 100%;
    background-color: var(--cover-color);
    box-shadow: var(--app-box-shadow);
    overflow: hidden;
  }

  .cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* No artwork: title block on the book's colour, spine hinted on the left */
  .cover__plain {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: 1rem 1rem 1rem 1.5rem;
    border-left: 0.5rem solid rgba(0, 0, 0, 0.25);
    color: var(--black);
  }

  .cover__title {
    font-family: var(--app-font-family-headings);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .cover__author {
    font-family: var(--app-font-family-monospace);
    font-size: 0.75rem;
  }
</style>
