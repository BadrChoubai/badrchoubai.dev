---
import Header from "@badrchoubai/ui/Header.astro";
import Footer from "@badrchoubai/ui/Footer.astro";
import BackToTop from "@badrchoubai/ui/BackToTop.astro";
import "@badrchoubai/ui/styles/base.css";
import { ClientRouter } from "astro:transitions";

import Head from "../components/Head.astro";
const { title, description, image, noindex } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
    <Head {title} {description} {image} {noindex}>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <ClientRouter />
    </Head>

    <body>
        <a href="#content" class="btn primary sm sr-only skip-link"
            >Skip to main content</a
        >
        <div class="frame">
            <Header title="Bookshelf">
                <li><a href="https://badrchoubai.dev/">home</a></li>
                <li>
                    <a href="https://badrchoubai.dev/#projects">projects</a>
                </li>
                <li>
                    <a href="https://bookshelf.badrchoubai.dev/">bookshelf</a>
                </li>
            </Header>
            <main id="content">
                <slot />
            </main>
            <Footer backToTop={false}>
                <div>
                    <h3>Online</h3>
                    <nav aria-label="Online">
                        <ul>
                            <li><a href="https://badrchoubai.dev/">home</a></li>
                            <li>
                                <a
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    href="https://www.github.com/BadrChoubai"
                                    >github</a
                                >
                            </li>
                            <li>
                                <a
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    href="https://www.linkedin.com/in/BadrChoubai"
                                    >linkedin</a
                                >
                            </li>
                        </ul>
                    </nav>
                </div>
            </Footer>
        </div>
        <BackToTop bottom="5rem" />
    </body>
</html>
