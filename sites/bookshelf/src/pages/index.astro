---
import { getCollection, type CollectionEntry } from "astro:content";
import { genres } from "../genres";
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Book from "../components/Book.astro";
import GenreNav from "../components/GenreNav.astro";

type BookData = CollectionEntry<"books">["data"];

/**
 * Catalogue heading for the first-listed author, inverted library-style:
 * "Kurt Vonnegut Jr." -> "Vonnegut, Kurt".
 */
const heading = ({ author, authorSort }: BookData) => {
    if (authorSort) return authorSort;
    const names = author
        .split("&")[0]
        .trim()
        .replace(/,?\s+(Jr|Sr)\.?$/, "")
        .split(/\s+/);
    const surname = names.pop()!;
    return `${surname}, ${names.join(" ")}`;
};

/** Titles file without a leading article: "The Fall" under "Fall". */
const filingTitle = ({ title }: BookData) => title.replace(/^(a|an|the)\s+/i, "");

// Word-by-word, ignoring case and diacritics ("Endō" files as "Endo")
const { compare } = new Intl.Collator("en", {
    sensitivity: "base",
    numeric: true,
});

const byAuthor = (a: BookData, b: BookData) =>
    compare(heading(a), heading(b)) || compare(filingTitle(a), filingTitle(b));

const books = (await getCollection("books")).map(({ data }) => data);
const allBooks = [...books].sort(byAuthor);
const shelves = [...genres]
    .sort(compare)
    .map((genre) => ({
        genre,
        id: genre.toLowerCase().replace(/[^a-z]+/g, "-"),
        books: books.filter((book) => book.genre === genre).sort(byAuthor),
    }))
    .filter((shelf) => shelf.books.length > 0);
---

<Layout title="Bookshelf" description="What I've Read.">
    <Section class="section" id="shelf">
        <div class="group">
            <h1>Bookshelf</h1>
            <p>What I've read, by genre.</p>
            <p>Total Amount of Books Read: {books.length}</p>
        </div>
        <div class="search">
            <label for="book-search" class="sr-only">Search books</label>
            <input
                id="book-search"
                class="search__input"
                type="search"
                placeholder="Search by title or author"
                autocomplete="off"
                spellcheck="false"
                data-book-search
            />
            <p class="search__status" role="status" data-book-search-status>
            </p>
        </div>

        <GenreNav {shelves} />

        {
            shelves.map(({ genre, id, books }) => (
                <section class="genre" aria-labelledby={id}>
                    <h2 id={id}>
                        {genre}{" "}
                        <span class="genre__count">
                            {books.length}{" "}
                            {books.length === 1 ? "book" : "books"}
                        </span>
                    </h2>
                    <ul class="shelf" role="list">
                        {books.map((book) => <Book {book} />)}
                    </ul>
                </section>
            ))
        }

        <section class="genre" aria-labelledby="all-books" hidden data-all-books>
            <h2 id="all-books">All Books</h2>
            <ul class="shelf" role="list">
                {allBooks.map((book) => <Book {book} />)}
            </ul>
        </section>
    </Section>
</Layout>

<script>
    /**
     * Filters books by title or author as you type. While searching, the
     * genre shelves and nav give way to a single "All Books" shelf.
     */
    function initSearch() {
        const input = document.querySelector<HTMLInputElement>(
            "[data-book-search]",
        );
        const status = document.querySelector<HTMLElement>(
            "[data-book-search-status]",
        );
        const all = document.querySelector<HTMLElement>("[data-all-books]");
        if (!input || !status || !all) return;

        const shelves = document.querySelectorAll<HTMLElement>(
            ".genre:not([data-all-books]), [data-genre-nav]",
        );
        const books = all.querySelectorAll<HTMLElement>(".book");

        const filter = () => {
            // Same normalisation as the build-time data-search text
            const query = input.value
                .normalize("NFD")
                .replace(/\p{Diacritic}/gu, "")
                .toLowerCase()
                .trim();
            let matches = 0;

            for (const book of books) {
                const match = book.dataset.search!.includes(query);
                book.hidden = !match;
                if (match) matches++;
            }

            for (const shelf of shelves) shelf.hidden = Boolean(query);
            all.hidden = !query || matches === 0;

            status.textContent = !query
                ? ""
                : matches === 0
                  ? "No books match."
                  : `${matches} of ${books.length} books`;
        };

        input.addEventListener("input", filter);
        // Escape leaves the field; the query and results stay put
        input.addEventListener("keydown", (event) => {
            if (event.key !== "Escape") return;
            // Stops Chrome and Safari clearing the field on Escape
            event.preventDefault();
            input.blur();
        });
        // Browsers may restore the field's value on back/forward navigation
        if (input.value) filter();
    }

    document.addEventListener("astro:page-load", initSearch);
</script>

<style>
    .search {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.5rem var(--app-spacing);
    }

    .search__input {
        flex: 1 1 16rem;
        max-width: 32rem;
        padding: 0.5rem 0.75rem;
        font: inherit;
        font-family: var(--app-font-family-monospace);
        font-size: 0.875rem;
        color: var(--app-color);
        background-color: var(--app-background-color);
        border: var(--app-border-width) solid var(--app-border-color);
        border-radius: var(--app-border-radius);
    }

    .search__input:focus-visible {
        outline: 2px solid var(--app-accent-color);
        outline-offset: 3px;
    }

    .search__status {
        margin: 0;
        font-family: var(--app-font-family-monospace);
        font-size: 0.875rem;
        opacity: 0.75;
    }

    /* Global section styles set display, which beats [hidden] */
    .genre[hidden] {
        display: none;
    }

    /* Genre shelves keep the global section divider, not its side padding */
    .genre {
        padding-inline: 0;
        padding-block: var(--app-spacing) calc(var(--app-spacing) * 2);
    }

    .genre__count {
        font-family: var(--app-font-family-monospace);
        font-size: 0.875rem;
        font-weight: 400;
        white-space: nowrap;
        opacity: 0.75;
    }

    .shelf {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
        gap: calc(var(--app-spacing) * 2) var(--app-spacing);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    /* Mobile: books lie on their side, stacked spine over spine */
    @media (max-width: 749px) {
        .shelf {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }
    }
</style>
