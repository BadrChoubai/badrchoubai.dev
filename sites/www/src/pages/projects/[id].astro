---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import { hasWriteup, isPublished } from "../../lib/projects";
import "../../styles/writeup.css";

// Only projects with a write-up in their Markdown body get a page
export async function getStaticPaths() {
  const projects = await getCollection(
    "projects",
    (entry) => isPublished(entry) && hasWriteup(entry),
  );
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<Layout title={data.title} description={data.description}>
  <Section class="section" id="writeup">
    <article class="writeup">
      <a class="writeup__back" href="/#projects">&larr; Projects</a>
      <header class="writeup__header">
        <h1>{data.title}</h1>
        <p class="writeup__desc">{data.description}</p>
        <ul class="writeup__stack" aria-label="Built with">
          {data.stack.map((tech) => <li>{tech}</li>)}
        </ul>
        {
          (data.repo || data.live) && (
            <div class="writeup__links">
              {data.repo && (
                <a href={data.repo} target="_blank" rel="noopener noreferrer">
                  source
                </a>
              )}
              {data.live && (
                <a href={data.live} target="_blank" rel="noopener noreferrer">
                  live
                </a>
              )}
            </div>
          )
        }
      </header>
      <div class="writeup__body">
        <Content />
      </div>
    </article>
  </Section>
</Layout>
