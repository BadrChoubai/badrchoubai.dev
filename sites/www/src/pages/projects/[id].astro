---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import { hasWriteup, isPublished } from "../../lib/projects";

// Only projects with a write-up in their Markdown body get a page
export async function getStaticPaths() {
  const projects = await getCollection(
    "projects",
    (entry) => isPublished(entry) && hasWriteup(entry),
  );
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<Layout title={data.title} description={data.description}>
  <Section class="section" id="writeup">
    <article class="writeup">
      <a class="writeup__back" href="/#projects">&larr; Projects</a>
      <header class="writeup__header">
        <h1>{data.title}</h1>
        <p class="writeup__desc">{data.description}</p>
        <ul class="writeup__stack" aria-label="Built with">
          {data.stack.map((tech) => <li>{tech}</li>)}
        </ul>
        {
          (data.repo || data.live) && (
            <div class="writeup__links">
              {data.repo && (
                <a href={data.repo} target="_blank" rel="noopener noreferrer">
                  source
                </a>
              )}
              {data.live && (
                <a href={data.live} target="_blank" rel="noopener noreferrer">
                  live
                </a>
              )}
            </div>
          )
        }
      </header>
      <div class="writeup__body">
        <Content />
      </div>
    </article>
  </Section>
</Layout>

<style>
  /* One reading column, matching the bookshelf notes pages */
  .writeup {
    width: 100%;
    max-width: 75ch;
    margin-inline: auto;
    padding-block: var(--app-spacing) calc(var(--app-spacing) * 3);
    font-size: clamp(1.0625rem, 0.95rem + 0.35vw, 1.1875rem);
    line-height: 1.7;
  }

  .writeup__back,
  .writeup__links {
    font-family: var(--app-font-family-monospace);
    font-size: 0.8125em;
  }

  .writeup__header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-block: calc(var(--app-spacing) * 1.5) calc(var(--app-spacing) * 2.5);
    padding-bottom: calc(var(--app-spacing) * 2);
    border-bottom: var(--app-rule-width) solid var(--app-rule-color);
  }

  .writeup__header h1 {
    margin: 0;
    font-size: clamp(2rem, 1.4rem + 2vw, 2.75rem);
    line-height: 1.1;
  }

  .writeup__desc {
    margin: 0;
    opacity: 0.75;
  }

  .writeup__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;

    li {
      margin: 0;
      padding: 0.15rem 0.5rem;
      list-style: none;
      background-color: var(--gray-700);
      font-family: var(--app-font-family-monospace);
      font-size: 0.75rem;
    }
  }

  .writeup__links {
    display: flex;
    gap: var(--app-spacing);
  }

  .writeup__body :global(:is(p, li, blockquote)) {
    font-size: 1em;
    line-height: inherit;
  }

  .writeup__body :global(:is(h2, h3, h4)) {
    margin-bottom: 0.5em;
    line-height: 1.25;
    text-wrap: balance;
  }

  .writeup__body :global(h2) {
    margin-top: 2.25em;
    font-size: 1.5em;
    font-weight: 700;
  }

  .writeup__body :global(h2:first-child) {
    margin-top: 0;
  }

  .writeup__body :global(h3) {
    margin-top: 1.75em;
    font-size: 1.25em;
    font-weight: 650;
  }

  .writeup__body :global(:is(ul, ol)) {
    padding-inline-start: 1.5em;
  }

  .writeup__body :global(li + li) {
    margin-top: 0.375em;
  }

  .writeup__body :global(blockquote) {
    margin-block: 1.5em;
    padding: 0.25em 0 0.25em 1.25em;
    border-inline-start-color: var(--app-accent-color);
  }

  /* Commands and config: scroll inside the block on narrow screens */
  .writeup__body :global(pre) {
    margin-block: 1.5em;
    padding: var(--app-spacing);
    overflow-x: auto;
    font-size: 0.8125em;
    line-height: 1.5;
  }

  .writeup__body :global(:not(pre) > code) {
    padding: 0.1em 0.3em;
    background-color: var(--gray-700);
    font-size: 0.875em;
  }

  .writeup__body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.5em auto;
  }
</style>
