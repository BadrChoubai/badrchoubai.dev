{
  "name": "www",
  "compatibility_date": "2025-11-11",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "badrchoubai.dev",
      "custom_domain": true,
    },
    {
      "pattern": "www.badrchoubai.dev",
      "custom_domain": true,
    },
  ],
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
  },
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
}
