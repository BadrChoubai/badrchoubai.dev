---
interface Props {
  /** Show the "back to top" link; turn off on sites that use BackToTop */
  backToTop?: boolean;
}

const { backToTop = true } = Astro.props;
---

<footer class="site-footer" id="footer">
  <div class="container">
    <!--
      Each child the site passes in is a column: a heading and a nav of
      links, or anything else, like a newsletter signup
    -->
    <div class="site-footer__inner">
      <slot />
    </div>

    <div class="site-footer__bottom">
      <small>&copy; 2026 Badr Choubai</small>
      {backToTop && <a href="#top">back to top</a>}
    </div>
  </div>
</footer>

<style>
  /*
   * The columns are the site's markup, rendered outside this component's
   * scope, so the rules that reach into them use :global()
   */
  .site-footer__inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--app-spacing);
  }

  /* Four or more columns share the row evenly */
  .site-footer__inner:has(> :nth-child(4)) {
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
  }

  .site-footer__inner > :global(*) {
    margin: 1rem 0;
    padding-inline: var(--app-block-spacing-horizontal);
  }

  .site-footer__inner :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__inner :global(li) {
    padding: 0;
  }

  /* Plain links; thin orange underline slides in on hover/focus */
  .site-footer :global(a) {
    text-decoration: none;
    background-image: linear-gradient(
      var(--accent, #d9680f),
      var(--accent, #d9680f)
    );
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.2s ease;
  }

  .site-footer :global(a:hover),
  .site-footer :global(a:focus-visible) {
    background-size: 100% 1px;
  }

  .site-footer :global(a:focus-visible) {
    outline: 2px solid var(--accent, #d9680f);
    outline-offset: 3px;
  }

  /* Bottom bar: hairline rule to match the section dividers above */
  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem var(--app-block-spacing-horizontal);
    border-top: var(--app-rule-width) solid var(--app-rule-color);
    font-size: 0.875rem;
    opacity: 0.75;
  }

  @media screen and (max-width: 749px) {
    .site-footer__inner,
    .site-footer__inner:has(> :nth-child(4)) {
      grid-template-columns: 1fr;
      grid-auto-flow: row;
      gap: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer :global(a) {
      transition: none;
    }
  }
</style>
